# Kopieer dit bestand naar .env en vul je eigen waarden in.

# Vereist voor de AI-waardering (markt- en liquidatiewaarde via Claude met websearch).
# Haal een sleutel op via https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: poort waarop de app draait (standaard 3000)
PORT=3000

# Optioneel: ander Claude-model (standaard claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Pincode-beveiliging. Zet een pincode (cijfers of tekst) om login te vereisen.
# Laat je dit leeg/weg, dan is de app open (geen login).
APP_PIN=4821

# Optioneel: geheim voor het ondertekenen van sessiecookies. Niet ingevuld?
# Dan wordt er automatisch één gegenereerd en bewaard in data/.session_secret.
# SESSION_SECRET=zet-hier-een-lange-willekeurige-string
